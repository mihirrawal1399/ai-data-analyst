# Oracle VM runtime env (used by deploy/oracle-vm/docker-compose.oracle-vm.yml)

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_SSL=true

API_PORT=4000
MCP_DB_PORT=5001
MCP_DB_URL=http://mcp-db:5001/mcp_db
API_SERVICE_KEY=replace_with_strong_random_key

API_BASE_URL=http://api:4000
WORKER_POLL_INTERVAL=60000
WORKER_LOG_LEVEL=info

LLM_PROVIDER=HARD_CODED
