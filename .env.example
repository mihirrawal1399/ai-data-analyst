# ======================================================
# Shared
# ======================================================

# PostgreSQL connection (required by API + MCP DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_data_analyst
DATABASE_SSL=false

# Internal service auth key (API <-> worker)
API_SERVICE_KEY=change_me_service_key

# ======================================================
# API (apps/api)
# ======================================================

API_PORT=4000

# MCP DB endpoint used by API
# Use /mcp_db (not /mcp_db_tool)
MCP_DB_URL=http://localhost:5001/mcp_db
MCP_DB_PORT=5001

# LLM provider selection
# HARD_CODED is useful for zero-cost local testing
LLM_PROVIDER=HARD_CODED
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# Provider keys (set only what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
GITHUB_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ======================================================
# MCP DB Tool (apps/mcp-db)
# ======================================================

# Tool server port
MCP_DB_PORT=5001

# Maximum rows allowed for SQL queries
MCP_DB_QUERY_LIMIT=200

# Optional: explicit path to root .env for mcp-db
# ROOT_ENV_PATH=./.env

# ======================================================
# Worker (apps/worker)
# ======================================================

API_BASE_URL=http://localhost:4000
WORKER_POLL_INTERVAL=60000
WORKER_LOG_LEVEL=info

# ======================================================
# Web (apps/web)
# ======================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ======================================================
# Optional local storage helper
# ======================================================

STORAGE_ROOT=./data
